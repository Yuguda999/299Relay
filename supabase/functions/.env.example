# Copy to supabase/functions/.env for `supabase functions serve` (never commit .env).
# In production set these with `supabase secrets set`.
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Paystack (test keys in dev/staging, live keys in production only)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_DVA_BANK=wema-bank

# Email (account and money events). Sender domain needs SPF, DKIM, DMARC.
RESEND_API_KEY=
EMAIL_FROM="299 RELAY <no-reply@your-domain>"

# Firebase Cloud Messaging service account JSON, on one line.
FCM_SERVICE_ACCOUNT=
